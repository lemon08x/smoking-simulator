.pack {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid;
  border-radius: 16rpx;
  box-shadow: 0 26rpx 56rpx rgba(0, 0, 0, 0.45), inset 0 1rpx rgba(255, 255, 255, 0.2);
}

.pack::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -70%;
  width: 58%;
  height: 150%;
  transform: rotate(18deg);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
  pointer-events: none;
}

.size-hero { width: 270rpx; height: 360rpx; }
.size-grid { width: 206rpx; height: 274rpx; }
.size-draw { width: 338rpx; height: 450rpx; border-radius: 22rpx; }
.size-bg { width: 750rpx; height: 1000rpx; border-radius: 40rpx; box-shadow: none; }

.pack-grain {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  opacity: 0.16;
  background-image: repeating-linear-gradient(105deg, rgba(255,255,255,0.08) 0, rgba(255,255,255,0.08) 1rpx, transparent 1rpx, transparent 5rpx);
  pointer-events: none;
}

.lid { position: absolute; top: 0; left: 0; right: 0; height: 22%; }
.lid-gloss { position: absolute; top: 0; right: 42%; bottom: 0; left: 0; background: linear-gradient(120deg, rgba(255,255,255,0.2), rgba(255,255,255,0)); }
.edition { position: absolute; top: 13rpx; right: 14rpx; color: rgba(255,255,255,0.58); font-size: 12rpx; font-weight: 700; letter-spacing: 2rpx; }
.lid-line { position: absolute; top: 22%; left: 0; right: 0; height: 3rpx; background: rgba(0,0,0,0.38); box-shadow: 0 2rpx rgba(255,255,255,0.09); }
.band { position: absolute; top: 30%; left: 9%; right: 9%; height: 8rpx; border-radius: 8rpx; opacity: 0.92; box-shadow: 0 0 12rpx rgba(0,0,0,0.18); }

.brand-box {
  position: absolute;
  top: 39%;
  right: 10%;
  bottom: 14%;
  left: 10%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.brand-rule { width: 58%; height: 1rpx; margin-bottom: 16rpx; background: currentColor; opacity: 0.45; }
.rule-bottom { width: 34%; margin: 16rpx 0 0; }
.brand { font-size: 32rpx; font-weight: 750; letter-spacing: 7rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.36); }
.label { margin-top: 9rpx; font-size: 17rpx; font-weight: 600; letter-spacing: 4rpx; opacity: 0.74; }
.pack-footer { position: absolute; right: 0; bottom: 16rpx; left: 0; z-index: 3; text-align: center; font-size: 10rpx; font-weight: 700; letter-spacing: 3rpx; opacity: 0.48; }

.size-draw .brand { font-size: 43rpx; }
.size-draw .label { font-size: 20rpx; }
.size-grid .brand { font-size: 25rpx; letter-spacing: 3rpx; }
.size-grid .label { font-size: 14rpx; letter-spacing: 2rpx; }
.size-grid .brand-rule { margin-bottom: 10rpx; }
.size-grid .rule-bottom { margin-top: 10rpx; }
.size-grid .edition { font-size: 9rpx; }
.size-grid .pack-footer { bottom: 10rpx; font-size: 8rpx; }

.silhouette { filter: grayscale(1) brightness(0.28); box-shadow: none; }
.silhouette .q { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 5; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.46); font-size: 66rpx; font-weight: 300; filter: none; }

.pattern { position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; }
.pattern-none { display: none; }
.pattern-clouds { background: radial-gradient(60rpx 40rpx at 30% 60%, rgba(255,255,255,0.22), transparent 70%), radial-gradient(80rpx 50rpx at 75% 80%, rgba(255,255,255,0.16), transparent 70%); }
.pattern-dots { background: radial-gradient(rgba(255,255,255,0.28) 3rpx, transparent 4rpx); background-size: 28rpx 28rpx; }
.pattern-frost { background: repeating-linear-gradient(115deg, rgba(160,220,255,0.1) 0, rgba(160,220,255,0.1) 2rpx, transparent 2rpx, transparent 14rpx); }
.pattern-mountain { background: radial-gradient(120rpx 90rpx at 20% 100%, rgba(220,235,220,0.16), transparent 70%), radial-gradient(150rpx 110rpx at 85% 100%, rgba(220,235,220,0.12), transparent 70%); }
.pattern-rays { background: repeating-conic-gradient(from 0deg at 50% 118%, rgba(255,255,255,0.1) 0deg 6deg, transparent 6deg 16deg); }
.pattern-foil { background: repeating-linear-gradient(45deg, rgba(255,255,255,0.12) 0, rgba(255,255,255,0.12) 3rpx, transparent 3rpx, transparent 12rpx), repeating-linear-gradient(-45deg, rgba(255,255,255,0.08) 0, rgba(255,255,255,0.08) 3rpx, transparent 3rpx, transparent 16rpx); }
