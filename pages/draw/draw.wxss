.draw-page { position: relative; min-height: 100vh; overflow: hidden; box-sizing: border-box; background: radial-gradient(ellipse at 50% 34%, #25242a 0%, #121317 48%, #090a0c 100%); }
.draw-page::before { content: ''; position: absolute; top: -220rpx; left: 50%; width: 680rpx; height: 680rpx; transform: translateX(-50%); border: 1rpx solid rgba(211,170,106,0.08); border-radius: 50%; box-shadow: 0 0 0 70rpx rgba(211,170,106,0.018), 0 0 0 140rpx rgba(211,170,106,0.012); }
.draw-noise { position: absolute; top: 0; right: 0; bottom: 0; left: 0; opacity: 0.1; background: repeating-linear-gradient(115deg, rgba(255,255,255,0.025) 0, rgba(255,255,255,0.025) 1rpx, transparent 1rpx, transparent 7rpx); pointer-events: none; }
.draw-head { position: relative; z-index: 4; padding-top: 42rpx; text-align: center; }
.draw-kicker { color: #8f7047; font-size: 14rpx; font-weight: 800; letter-spacing: 6rpx; }
.draw-title { margin-top: 10rpx; color: #eee8df; font-size: 34rpx; font-weight: 650; letter-spacing: 3rpx; }
.cost-tip { margin-top: 8rpx; color: #5f626a; font-size: 19rpx; }

.stage { position: relative; z-index: 2; width: 100%; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.ready-stage { min-height: 890rpx; padding-top: 54rpx; }
.mystery-wrap { position: relative; z-index: 3; transition: transform 0.2s; }
.mystery-wrap:active { transform: scale(0.985); }
.pack-shadow { position: absolute; right: 14%; bottom: -34rpx; left: 14%; height: 50rpx; border-radius: 50%; background: rgba(0,0,0,0.65); filter: blur(18rpx); }
.orbit { position: absolute; top: 98rpx; left: 50%; border: 1rpx solid rgba(210,168,101,0.12); border-radius: 50%; transform: translateX(-50%); }
.orbit-one { width: 500rpx; height: 500rpx; }
.orbit-two { top: 153rpx; width: 390rpx; height: 390rpx; border-color: rgba(210,168,101,0.18); }

@keyframes shake {
  0%, 100% { transform: translateX(0) rotate(0deg); }
  12% { transform: translateX(-12rpx) rotate(-2deg); }
  25% { transform: translateX(10rpx) rotate(2deg); }
  38% { transform: translateX(-14rpx) rotate(-2.5deg); }
  52% { transform: translateX(12rpx) rotate(2deg); }
  68% { transform: translateX(-8rpx) rotate(-1deg); }
  84% { transform: translateX(6rpx) rotate(1deg); }
}
.shaking { animation: shake 0.92s ease-in-out; }
.open-copy { position: relative; z-index: 3; margin-top: 50rpx; text-align: center; }
.open-line { color: #d8d2c9; font-size: 27rpx; font-weight: 600; }
.open-sub { margin-top: 8rpx; color: #666970; font-size: 20rpx; }
.open-trigger { position: relative; z-index: 3; width: 260rpx; height: 76rpx; margin-top: 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #cfad74; font-size: 22rpx; font-weight: 650; letter-spacing: 3rpx; }
.trigger-line { width: 82rpx; height: 1rpx; margin-top: 10rpx; background: linear-gradient(90deg, transparent, #b9945d, transparent); }
.trigger-busy { opacity: 0.55; }

.reveal-stage { min-height: 940rpx; padding-top: 34rpx; }
.reveal-kicker { position: relative; z-index: 4; margin-bottom: 22rpx; color: #b9975f; font-size: 16rpx; font-weight: 800; letter-spacing: 6rpx; }
@keyframes flipIn { 0% { opacity: 0; transform: rotateY(82deg) scale(0.88); } 100% { opacity: 1; transform: rotateY(0) scale(1); } }
.anim-flip { animation: flipIn 0.62s cubic-bezier(0.22,1,0.36,1) both; }
.result-card { position: relative; z-index: 3; }
.reveal-glow { position: absolute; top: 30rpx; left: 50%; z-index: 1; width: 620rpx; height: 620rpx; transform: translateX(-50%); border-radius: 50%; filter: blur(28rpx); animation: revealPulse 2s ease-in-out infinite; }
@keyframes revealPulse { 0%,100% { opacity: 0.55; } 50% { opacity: 0.92; } }
.glow-common { background: radial-gradient(circle, rgba(220,224,230,0.25), transparent 65%); }
.glow-rare { background: radial-gradient(circle, rgba(112,125,237,0.38), transparent 65%); }
.glow-legend { background: radial-gradient(circle, rgba(232,182,76,0.44), transparent 65%); }
.result-meta { position: relative; z-index: 3; margin-top: 34rpx; display: flex; flex-direction: column; align-items: center; }
.result-topline { display: flex; align-items: center; gap: 10rpx; }
.new-tag { padding: 5rpx 11rpx; border-radius: 99rpx; color: #17120d; background: #d8b474; font-size: 14rpx; font-weight: 800; letter-spacing: 2rpx; }
.result-name { margin-top: 14rpx; color: #f2ece3; font-size: 43rpx; font-weight: 680; letter-spacing: 5rpx; }
.result-line { max-width: 590rpx; margin-top: 15rpx; color: #858890; text-align: center; font-size: 22rpx; line-height: 1.5; }
.duplicate-result { margin-top: 18rpx; padding: 10rpx 16rpx; display: flex; gap: 16rpx; border: 1rpx solid rgba(255,255,255,0.07); border-radius: 99rpx; color: #858890; background: rgba(255,255,255,0.03); font-size: 18rpx; }
.refund { color: #d1ad72; }
.ok-btn { position: relative; z-index: 4; width: calc(100% - 112rpx); margin-top: 34rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.ok-arrow { font-size: 34rpx; font-weight: 400; }
