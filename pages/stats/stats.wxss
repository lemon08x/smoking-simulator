.stats-page { overflow: hidden; }
.overview { position: relative; padding: 34rpx; overflow: hidden; border: 1rpx solid rgba(216,172,105,0.2); border-radius: 32rpx; background: radial-gradient(circle at 86% 20%, rgba(190,140,73,0.2), transparent 36%), linear-gradient(145deg, #252329, #15161a 72%); }
.overview::after { content: ''; position: absolute; top: -80rpx; right: -80rpx; width: 270rpx; height: 270rpx; border: 1rpx solid rgba(220,178,112,0.1); border-radius: 50%; box-shadow: 0 0 0 38rpx rgba(220,178,112,0.025); }
.overview-kicker { color: #927348; font-size: 14rpx; font-weight: 800; letter-spacing: 5rpx; }
.overview-number { margin-top: 8rpx; color: #eed29a; font-size: 104rpx; font-weight: 670; letter-spacing: -4rpx; line-height: 1.1; }
.overview-unit { color: #9a9287; font-size: 22rpx; }
.overview-line { width: 60rpx; height: 2rpx; margin-top: 26rpx; background: #b58a4e; }
.overview-foot { margin-top: 14rpx; color: #6f7279; font-size: 20rpx; }

.metric-grid { margin-top: 18rpx; display: flex; gap: 12rpx; }
.metric-card { flex: 1; min-width: 0; padding: 20rpx 12rpx; display: flex; flex-direction: column; align-items: center; border: 1rpx solid rgba(255,255,255,0.06); border-radius: 22rpx; background: rgba(25,26,30,0.86); }
.metric-mark { width: 34rpx; height: 34rpx; margin-bottom: 11rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 18rpx; font-weight: 700; }
.money-mark { color: #d8b677; background: rgba(211,166,97,0.12); }
.time-mark { color: #8eb89d; background: rgba(121,171,141,0.12); }
.streak-mark { color: #aab0ed; background: rgba(133,142,224,0.12); }
.metric-value { max-width: 100%; overflow: hidden; color: #e2ddd5; font-size: 23rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.metric-label { margin-top: 6rpx; color: #62656d; font-size: 16rpx; }

.reward-progress, .heat-card, .timeline-card { margin-top: 18rpx; }
.progress-number { color: #777a82; font-size: 21rpx; }
.progress-number text { color: #dfbd7d; font-size: 34rpx; font-weight: 700; }
.progress-track { height: 8rpx; margin-top: 28rpx; overflow: hidden; border-radius: 99rpx; background: #2a2b31; }
.progress-fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #9f713b, #e2bf7d); box-shadow: 0 0 14rpx rgba(221,179,110,0.32); }
.card-note { margin-top: 14rpx; color: #666970; font-size: 19rpx; }

.heat { margin-top: 28rpx; display: flex; flex-wrap: wrap; gap: 11rpx; }
.heat-cell { width: 35rpx; height: 35rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,0.025); border-radius: 8rpx; }
.lv0 { background: #282a2f; }
.lv1 { background: #59482f; }
.lv2 { background: #9b7542; }
.lv3 { background: #d5ad6d; box-shadow: 0 0 12rpx rgba(211,170,103,0.2); }
.heat-legend { margin-top: 20rpx; display: flex; align-items: center; justify-content: flex-end; gap: 8rpx; color: #62656c; font-size: 17rpx; }
.legend-dot { width: 18rpx; height: 18rpx; border-radius: 5rpx; }

.timeline-title { margin-top: 8rpx; }
.timeline { margin-top: 28rpx; }
.timeline-item { display: flex; min-height: 90rpx; }
.timeline-axis { width: 28rpx; margin-right: 18rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.timeline-dot { width: 15rpx; height: 15rpx; margin-top: 5rpx; box-sizing: border-box; border: 3rpx solid #3e4047; border-radius: 50%; background: #24262b; }
.timeline-line { width: 1rpx; flex: 1; margin-top: 6rpx; background: #303238; }
.timeline-item:last-child .timeline-line { display: none; }
.timeline-body { padding-bottom: 24rpx; }
.timeline-name { color: #74777f; font-size: 24rpx; font-weight: 580; }
.timeline-desc { margin-top: 6rpx; color: #595c63; font-size: 20rpx; }
.reached .timeline-dot { border-color: rgba(137,188,156,0.42); background: #86b79a; box-shadow: 0 0 12rpx rgba(128,181,148,0.28); }
.reached .timeline-name { color: #ddd8d0; }
.reached .timeline-desc { color: #767a81; }
.done { margin-left: 8rpx; padding: 3rpx 8rpx; border-radius: 99rpx; color: #9ac4a8; background: rgba(123,177,143,0.1); font-size: 14rpx; }
