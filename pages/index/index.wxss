.home {
  overflow: hidden;
  padding-top: 26rpx;
}

.ambient {
  position: absolute;
  border-radius: 50%;
  filter: blur(20rpx);
  pointer-events: none;
}
.ambient-one { top: 120rpx; right: -190rpx; width: 500rpx; height: 500rpx; background: radial-gradient(circle, rgba(154,108,56,0.14), transparent 68%); }
.ambient-two { top: 700rpx; left: -260rpx; width: 500rpx; height: 500rpx; background: radial-gradient(circle, rgba(81,88,110,0.09), transparent 68%); }

.home-head { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; }
.brand-en { color: #a88754; font-size: 17rpx; font-weight: 800; letter-spacing: 7rpx; }
.brand-cn { margin-top: 5rpx; color: #f4efe7; font-size: 38rpx; font-weight: 650; letter-spacing: 4rpx; }
.streak-pill { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 18rpx; border: 1rpx solid rgba(210,164,93,0.2); border-radius: 999rpx; color: #b7a990; background: rgba(207,159,88,0.06); font-size: 21rpx; }
.streak-flame { width: 12rpx; height: 18rpx; border-radius: 9rpx 9rpx 9rpx 2rpx; transform: rotate(12deg); background: linear-gradient(#f0d08c, #b87a38); box-shadow: 0 0 14rpx rgba(229,174,91,0.5); }

.hero-stage { position: relative; z-index: 1; height: 470rpx; margin-top: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.hero-label { position: absolute; top: 34rpx; left: 0; color: #585b63; font-size: 15rpx; font-weight: 700; letter-spacing: 5rpx; writing-mode: vertical-rl; }
.pack-halo { position: absolute; top: 64rpx; width: 380rpx; height: 330rpx; border-radius: 50%; background: radial-gradient(circle, rgba(207,159,88,0.2), rgba(135,94,48,0.05) 45%, transparent 70%); filter: blur(6rpx); }
.pack-wrap { position: relative; z-index: 2; transform: perspective(900rpx) rotateY(-5deg) rotateX(2deg); }
.pedestal { position: absolute; z-index: 1; bottom: 68rpx; width: 360rpx; height: 34rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(0,0,0,0.72), transparent 68%); }
.skin-meta { position: absolute; z-index: 3; right: 0; bottom: 56rpx; display: flex; align-items: center; gap: 12rpx; }
.skin-name { font-size: 25rpx; font-weight: 650; letter-spacing: 2rpx; }
.change-hint { position: absolute; right: 0; bottom: 22rpx; color: #6f727a; font-size: 19rpx; }
.change-hint text { margin-left: 6rpx; color: #b5915c; }

.stats-strip { position: relative; z-index: 2; display: flex; align-items: stretch; padding: 22rpx 10rpx; border-top: 1rpx solid rgba(255,255,255,0.07); border-bottom: 1rpx solid rgba(255,255,255,0.07); }
.stat-main, .stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.stat-value { color: #e5c384; font-size: 38rpx; font-weight: 680; line-height: 1.1; }
.stat-value.small { max-width: 190rpx; overflow: hidden; color: #e8e2d9; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.stat-label { margin-top: 8rpx; color: #696d75; font-size: 18rpx; letter-spacing: 1rpx; }
.stat-divider { width: 1rpx; margin: 6rpx 0; background: rgba(255,255,255,0.07); }

.reward-panel { position: relative; z-index: 2; margin-top: 24rpx; padding: 25rpx 50rpx 25rpx 24rpx; display: flex; align-items: center; border: 1rpx solid rgba(215,170,101,0.16); border-radius: 24rpx; background: linear-gradient(125deg, rgba(63,48,30,0.48), rgba(25,25,29,0.82) 52%, rgba(30,31,36,0.92)); }
.panel-copy { width: 180rpx; flex-shrink: 0; }
.panel-kicker { color: #8b6d43; font-size: 13rpx; font-weight: 800; letter-spacing: 3rpx; }
.panel-title { margin-top: 7rpx; color: #e9e2d8; font-size: 25rpx; font-weight: 620; }
.wallet-values { flex: 1; display: flex; justify-content: space-around; }
.wallet-item { display: flex; flex-direction: column; align-items: center; }
.wallet-value { color: #e4bd78; font-size: 29rpx; font-weight: 700; }
.wallet-label { margin-top: 4rpx; color: #6f727a; font-size: 16rpx; }
.panel-arrow { position: absolute; right: 18rpx; color: #8c7049; font-size: 40rpx; }

.milestone { position: relative; z-index: 2; margin-top: 18rpx; padding: 24rpx; border: 1rpx solid rgba(255,255,255,0.06); border-radius: 24rpx; background: rgba(23,24,28,0.72); }
.milestone-top { display: flex; justify-content: space-between; align-items: flex-start; }
.milestone-kicker { color: #686b73; font-size: 13rpx; font-weight: 700; letter-spacing: 3rpx; }
.milestone-title { margin-top: 8rpx; color: #ddd8d0; font-size: 25rpx; font-weight: 600; }
.milestone-pct { color: #8dbba0; font-size: 28rpx; font-weight: 700; }
.milestone-desc { margin-top: 8rpx; color: #70747c; font-size: 20rpx; }
.milestone-bar { height: 6rpx; margin-top: 20rpx; overflow: hidden; border-radius: 99rpx; background: #2a2c31; }
.milestone-fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #638e74, #9bc3a7); box-shadow: 0 0 14rpx rgba(126,177,146,0.28); transition: width 0.45s ease; }

.cta { position: relative; z-index: 2; margin-top: 24rpx; }
.draw-ready { height: 58rpx; margin-bottom: 12rpx; padding: 0 20rpx; display: flex; align-items: center; border: 1rpx solid rgba(215,170,101,0.18); border-radius: 18rpx; color: #bca982; background: rgba(188,142,76,0.06); font-size: 20rpx; }
.ready-dot { width: 10rpx; height: 10rpx; margin-right: 12rpx; border-radius: 50%; background: #e3bb73; box-shadow: 0 0 14rpx rgba(227,187,115,0.7); }
.ready-arrow { margin-left: auto; font-size: 30rpx; }
.smoke-button { width: 100%; height: 104rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; line-height: normal; text-align: left; }
.button-copy { display: flex; flex-direction: column; }
.button-title { font-size: 30rpx; font-weight: 750; }
.button-sub { margin-top: 5rpx; color: rgba(24,20,14,0.62); font-size: 18rpx; font-weight: 550; letter-spacing: 0; }
.button-arrow { font-size: 38rpx; font-weight: 400; }

.mode-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(5,5,7,0.82); backdrop-filter: blur(12rpx); }
.mode-sheet { width: 100%; padding: 20rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-top: 1rpx solid rgba(255,255,255,0.1); border-radius: 38rpx 38rpx 0 0; background: linear-gradient(155deg, #202126, #121317 72%); box-shadow: 0 -30rpx 80rpx rgba(0,0,0,0.5); }
.sheet-handle { width: 70rpx; height: 7rpx; margin: 0 auto 28rpx; border-radius: 10rpx; background: #3b3d43; }
.mode-kicker { color: #a88754; font-size: 15rpx; font-weight: 800; letter-spacing: 5rpx; }
.mode-title { margin-top: 10rpx; color: #f2ede5; font-size: 38rpx; font-weight: 650; }
.mode-subtitle { margin: 10rpx 0 24rpx; color: #73767e; font-size: 21rpx; }
.mode-option { width: 100%; min-height: 126rpx; margin-top: 14rpx; padding: 20rpx; display: flex; align-items: center; color: #ded9d1; text-align: left; border: 1rpx solid rgba(255,255,255,0.07); border-radius: 24rpx; background: rgba(255,255,255,0.035); }
.mode-option::after, .mode-cancel::after { border: 0; }
.mode-option:active { background: rgba(255,255,255,0.07); }
.mode-last { border-color: rgba(211,166,97,0.45); background: linear-gradient(110deg, rgba(172,126,65,0.12), rgba(255,255,255,0.025)); }
.mode-icon { width: 72rpx; height: 72rpx; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1rpx solid rgba(215,208,196,0.15); border-radius: 50%; color: #d2c9ba; background: #27282d; font-size: 25rpx; font-weight: 650; }
.rhythm-icon { color: #1b160f; border-color: rgba(234,208,157,0.5); background: linear-gradient(145deg, #e2c184, #a77a42); }
.mode-copy { flex: 1; display: flex; flex-direction: column; }
.mode-name-row { display: flex; align-items: center; gap: 12rpx; }
.mode-name { font-size: 27rpx; font-weight: 650; }
.mode-desc { margin-top: 7rpx; color: #777b83; font-size: 20rpx; line-height: 1.35; }
.reward-badge { padding: 4rpx 10rpx; border-radius: 99rpx; color: #e3c17e; background: rgba(204,155,83,0.12); font-size: 15rpx; font-weight: 700; }
.mode-arrow { color: #92754d; font-size: 34rpx; }
.mode-cancel { height: 72rpx; margin-top: 16rpx; line-height: 72rpx; color: #70737b; background: transparent; font-size: 23rpx; }
