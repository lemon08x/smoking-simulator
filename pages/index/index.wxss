.container {
  justify-content: space-between;
  padding-bottom: 60rpx;
}

/* 数据三连 */
.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  background: #1e2128;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat .v {
  font-size: 40rpx;
  font-weight: 700;
  color: #c8a063;
}
.stat .k {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8f99;
}
.divider {
  width: 1rpx;
  height: 52rpx;
  background: #2c3038;
}

/* 烟盒英雄区 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.skin-meta {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.skin-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.change-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

/* 连续天数 */
.streak {
  font-size: 26rpx;
  color: #b8bdc7;
}
.streak-num {
  color: #e8b64c;
  font-weight: 700;
  font-size: 30rpx;
}

/* 奖励账户 */
.reward-wallet {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 40rpx 20rpx 24rpx;
  border: 1rpx solid rgba(200, 160, 99, 0.18);
  border-radius: 20rpx;
  background: rgba(200, 160, 99, 0.06);
}
.wallet-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wallet-v {
  color: #e8cf9a;
  font-size: 27rpx;
  font-weight: 700;
}
.wallet-k {
  margin-top: 4rpx;
  color: #7f858f;
  font-size: 19rpx;
}
.wallet-line {
  width: 1rpx;
  height: 40rpx;
  background: #343944;
}
.wallet-arrow {
  position: absolute;
  right: 16rpx;
  color: #8a8f99;
  font-size: 38rpx;
}

/* 里程碑 */
.ms {
  width: 100%;
  box-sizing: border-box;
  background: #1e2128;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
}
.ms-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.ms-title {
  font-size: 26rpx;
  color: #d8dce2;
}
.ms-desc {
  font-size: 22rpx;
  color: #8a8f99;
}
.ms-bar {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: #2c3038;
  overflow: hidden;
}
.ms-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #6fbf8f, #8fd8b0);
  transition: width 0.4s ease;
}

/* 点烟 CTA */
.cta {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ticket-tip {
  margin-bottom: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(200, 160, 99, 0.14);
  border: 1rpx solid rgba(200, 160, 99, 0.4);
  color: #e8cf9a;
  font-size: 24rpx;
}
.btn-light {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
}
.hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a8f99;
  letter-spacing: 4rpx;
}

/* 模式选择 */
.mode-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(7, 8, 11, 0.72);
}
.mode-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #1e2128;
  border-top: 1rpx solid #343944;
}
.mode-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f1f2f4;
}
.mode-subtitle {
  margin-top: 8rpx;
  margin-bottom: 26rpx;
  font-size: 23rpx;
  color: #8a8f99;
}
.mode-option {
  width: 100%;
  min-height: 116rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  text-align: left;
  color: #d8dce2;
  background: #262a32;
  border: 1rpx solid #343944;
  border-radius: 22rpx;
}
.mode-option::after {
  border: 0;
}
.mode-last {
  border-color: rgba(200, 160, 99, 0.72);
  background: rgba(200, 160, 99, 0.1);
}
.mode-icon {
  width: 68rpx;
  font-size: 36rpx;
}
.mode-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.mode-name {
  font-size: 29rpx;
  font-weight: 600;
}
.mode-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #989eaa;
}
.mode-arrow {
  font-size: 44rpx;
  color: #c8a063;
}
.mode-cancel {
  margin-top: 24rpx;
  color: #8a8f99;
  background: transparent;
  font-size: 25rpx;
}
.mode-cancel::after {
  border: 0;
}
