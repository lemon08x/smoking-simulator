<view class="container">
  <!-- 今日三连数据 -->
  <view class="stats anim-fade-up">
    <view class="stat">
      <text class="v">{{today}}</text>
      <text class="k">今日 · 根</text>
    </view>
    <view class="divider"></view>
    <view class="stat">
      <text class="v">{{moneyText}}</text>
      <text class="k">累计省下</text>
    </view>
    <view class="divider"></view>
    <view class="stat">
      <text class="v">{{lifeText}}</text>
      <text class="k">寿命 +</text>
    </view>
  </view>

  <!-- 当前烟盒 -->
  <view class="hero anim-pop" bindtap="goBox">
    <pack skin="{{skin}}" size="hero" />
    <view class="skin-meta">
      <text class="skin-name">{{skin.name}}</text>
      <view class="rarity-tag rarity-{{skin.rarity}}">{{rarityName}}</view>
    </view>
    <view class="change-hint">点击换肤 ›</view>
  </view>

  <!-- 连续戒断 -->
  <view class="streak anim-fade-up">🔥 连续戒断 <text class="streak-num">{{streak}}</text> 天</view>

  <view class="reward-wallet anim-fade-up" bindtap="goBox">
    <view class="wallet-item"><text class="wallet-v">{{fragments}}/5</text><text class="wallet-k">烟标碎片</text></view>
    <view class="wallet-line"></view>
    <view class="wallet-item"><text class="wallet-v">{{freeDraws}}</text><text class="wallet-k">免费单抽</text></view>
    <view class="wallet-line"></view>
    <view class="wallet-item"><text class="wallet-v">{{packDraws}}</text><text class="wallet-k">保底开盒</text></view>
    <text class="wallet-arrow">›</text>
  </view>

  <!-- 健康里程碑 -->
  <view class="ms anim-fade-up">
    <view class="ms-head">
      <text class="ms-title">下一站 · {{ms.title}}</text>
      <text class="ms-desc">{{ms.desc}}</text>
    </view>
    <view class="ms-bar">
      <view class="ms-fill" style="width: {{ms.pct}}%"></view>
    </view>
  </view>

  <!-- 点烟入口 -->
  <view class="cta">
    <view wx:if="{{canDraw}}" class="ticket-tip anim-pop" bindtap="goBox">
      🎁 有可用抽卡，去看看
    </view>
    <button class="btn-gold btn-light" bindtap="onSmoke">🚬 点一根</button>
    <view class="hint">自由掌控，或跟随 45 秒节奏</view>
  </view>

  <view wx:if="{{showModePicker}}" class="mode-mask" bindtap="closeModePicker">
    <view class="mode-sheet anim-pop" catchtap="noop">
      <view class="mode-title">这根怎么抽？</view>
      <view class="mode-subtitle">两种玩法都会自然燃尽并自动结算</view>
      <button class="mode-option {{lastMode === 'free' ? 'mode-last' : ''}}" data-mode="free" bindtap="startMode">
        <view class="mode-icon">🚬</view>
        <view class="mode-copy">
          <text class="mode-name">自由模式</text>
          <text class="mode-desc">按住吸入 · 松开吐烟</text>
        </view>
        <text class="mode-arrow">›</text>
      </button>
      <button class="mode-option {{lastMode === 'rhythm' ? 'mode-last' : ''}}" data-mode="rhythm" bindtap="startMode">
        <view class="mode-icon">〰️</view>
        <view class="mode-copy">
          <text class="mode-name">45 秒节奏</text>
          <text class="mode-desc">跟随振动 · 自然呼吸</text>
        </view>
        <text class="mode-arrow">›</text>
      </button>
      <button class="mode-cancel" bindtap="closeModePicker">先等等</button>
    </view>
  </view>
</view>
