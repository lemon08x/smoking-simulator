<view class="container collection-page">
  <view class="page-head anim-fade-up">
    <view class="page-kicker">YOUR COLLECTION</view>
    <view class="page-title">烟盒收藏</view>
    <view class="page-subtitle">每一次完成都会让收藏离你更近一点</view>
  </view>

  <view class="vault anim-fade-up">
    <view class="vault-top">
      <view class="fragment-orb">
        <text class="orb-value">{{fragments}}</text>
        <text class="orb-total">/ 5</text>
      </view>
      <view class="vault-copy">
        <view class="vault-kicker">烟标碎片</view>
        <view class="vault-title">{{fragments >= 5 ? '已经可以开启一次' : '再收集一些即可单抽'}}</view>
        <view class="fragment-track"><view class="fragment-fill" style="width: {{fragments >= 5 ? 100 : fragments * 20}}%"></view></view>
      </view>
    </view>

    <view class="vault-stats">
      <view class="vault-stat"><text class="vault-value">{{freeDraws}}</text><text class="vault-label">免费单抽</text></view>
      <view class="vault-line"></view>
      <view class="vault-stat"><text class="vault-value">{{packDraws}}</text><text class="vault-label">稀有保底</text></view>
      <view class="vault-line"></view>
      <view class="vault-stat"><text class="vault-value">{{cigsToNext}}</text><text class="vault-label">距下次保底</text></view>
    </view>

    <view class="draw-actions">
      <button class="draw-button single {{canSingle ? '' : 'draw-disabled'}}" bindtap="onSingleDraw">
        <text class="draw-button-kicker">SINGLE DRAW</text>
        <text class="draw-button-title">{{freeDraws > 0 ? '免费开启 ×' + freeDraws : '碎片单抽 · 5'}}</text>
      </button>
      <button class="draw-button pack-draw {{packDraws > 0 ? '' : 'draw-disabled'}}" bindtap="onPackDraw">
        <text class="draw-button-kicker">RARE GUARANTEE</text>
        <text class="draw-button-title">稀有保底{{packDraws > 0 ? ' ×' + packDraws : ''}}</text>
      </button>
    </view>
    <view class="vault-rule">5 个碎片兑换单抽 · 每 20 次有效完成获得稀有保底</view>
  </view>

  <view class="section-head collection-head anim-fade-up">
    <view>
      <view class="section-kicker">PACK ARCHIVE</view>
      <view class="section-title">全部款式</view>
    </view>
    <view class="section-meta">{{collected}} / {{total}} 已收集</view>
  </view>

  <view class="grid">
    <view
      wx:for="{{list}}"
      wx:key="skin.id"
      class="cell anim-fade-up {{item.isCurrent ? 'current' : ''}} {{item.owned ? '' : 'locked'}}"
      data-idx="{{index}}"
      bindtap="onPick"
    >
      <view wx:if="{{item.isCurrent}}" class="using">正在使用</view>
      <view wx:if="{{item.count > 1}}" class="duplicate">×{{item.count}}</view>
      <view class="cell-pack"><pack skin="{{item.skin}}" size="grid" mode="{{item.owned ? 'full' : 'silhouette'}}" /></view>
      <view class="cell-info">
        <view class="cell-name">{{item.owned ? item.skin.name : '尚未解锁'}}</view>
        <view class="rarity-tag rarity-{{item.skin.rarity}}">{{item.rarityName}}</view>
      </view>
    </view>
  </view>

  <view class="collection-foot">已开启 {{draws}} 次{{allCollected ? ' · 全部收藏已完成' : ' · 重复款会返还烟标碎片'}}</view>
</view>
