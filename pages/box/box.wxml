<view class="container">
  <!-- 收集概况 -->
  <view class="card summary anim-fade-up">
    <view class="sum-row">
      <view class="sum-item">
        <text class="sum-v">{{fragments}}/5</text>
        <text class="sum-k">烟标碎片</text>
      </view>
      <view class="sum-item">
        <text class="sum-v">{{freeDraws}}</text>
        <text class="sum-k">免费单抽</text>
      </view>
      <view class="sum-item">
        <text class="sum-v">{{packDraws}}</text>
        <text class="sum-k">稀有保底</text>
      </view>
    </view>
    <view class="rule">5 个碎片抽一次 · 每 20 次有效完成获得稀有保底</view>
    <view class="draw-actions">
      <button class="btn-gold draw-btn {{canSingle ? '' : 'draw-disabled'}}" bindtap="onSingleDraw">
        {{freeDraws > 0 ? '免费抽一次 ×' + freeDraws : '碎片单抽 · 5'}}
      </button>
      <button class="btn-gold draw-btn draw-pack {{packDraws > 0 ? '' : 'draw-disabled'}}" bindtap="onPackDraw">
        稀有保底{{packDraws > 0 ? ' ×' + packDraws : ''}}
      </button>
    </view>
    <view class="collection-count">已开 {{draws}} 次 · 收集 {{collected}}/{{total}}{{allCollected ? ' · 🏆 全收集' : ''}}</view>
  </view>

  <!-- 烟盒九宫格 -->
  <view class="grid">
    <view
      wx:for="{{list}}"
      wx:key="skin.id"
      class="cell anim-fade-up {{item.isCurrent ? 'current' : ''}}"
      data-idx="{{index}}"
      bindtap="onPick"
    >
      <pack skin="{{item.skin}}" size="grid" mode="{{item.owned ? 'full' : 'silhouette'}}" />
      <view class="cell-name">{{item.owned ? item.skin.name : '？？？'}}</view>
      <view class="rarity-tag rarity-{{item.skin.rarity}}">{{item.rarityName}}</view>
      <view wx:if="{{item.count > 1}}" class="dup">×{{item.count}}</view>
      <view wx:if="{{item.isCurrent}}" class="using">使用中</view>
    </view>
  </view>
</view>
