/* 全局视觉：暖黑、象牙白与黄铜金 */
page {
  min-height: 100%;
  background: #0d0e11;
  color: #f3efe8;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Microsoft YaHei", sans-serif;
}

button,
input {
  font: inherit;
}

.container {
  position: relative;
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(31, 32, 37, 0.96), rgba(20, 21, 25, 0.96));
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.22);
}

.page-head {
  width: 100%;
  margin-bottom: 30rpx;
}

.page-kicker,
.section-kicker {
  color: #a88754;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.page-title {
  margin-top: 10rpx;
  color: #f6f1e8;
  font-size: 48rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #777b84;
  font-size: 23rpx;
  line-height: 1.55;
}

.section-head {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  color: #ebe6de;
  font-size: 30rpx;
  font-weight: 620;
}

.section-meta {
  color: #777b84;
  font-size: 21rpx;
}

.btn-gold {
  height: 92rpx;
  line-height: 92rpx;
  border: 1rpx solid rgba(255, 238, 198, 0.34);
  border-radius: 24rpx;
  color: #18140e;
  background: linear-gradient(135deg, #f0d59d 0%, #c79d5e 55%, #a8783e 100%);
  box-shadow: 0 16rpx 38rpx rgba(145, 102, 49, 0.22), inset 0 1rpx rgba(255, 255, 255, 0.5);
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.btn-gold::after,
.btn-ghost::after {
  border: 0;
}

.btn-gold:active {
  transform: translateY(2rpx) scale(0.992);
  opacity: 0.92;
}

.btn-ghost {
  border: 0;
  color: #8a8d95;
  background: transparent;
  font-size: 25rpx;
}

.rarity-tag {
  display: inline-flex;
  align-items: center;
  min-height: 30rpx;
  padding: 4rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid;
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1;
}

.rarity-common {
  color: #b7bcc4;
  border-color: rgba(183, 188, 196, 0.3);
  background: rgba(183, 188, 196, 0.07);
}

.rarity-rare {
  color: #a9b1ff;
  border-color: rgba(131, 145, 255, 0.38);
  background: rgba(102, 117, 232, 0.1);
}

.rarity-legend {
  color: #f2cf7d;
  border-color: rgba(232, 182, 76, 0.45);
  background: rgba(232, 182, 76, 0.1);
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes popIn {
  0% { opacity: 0; transform: translateY(18rpx) scale(0.97); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.48; transform: scale(0.96); }
  50% { opacity: 0.9; transform: scale(1.04); }
}

.anim-fade-up {
  animation: fadeUp 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.anim-pop {
  animation: popIn 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}
